# URL publique du site, sans barre finale. Elle sert de base aux URL
# canoniques, aux `hreflang`, au sitemap et aux images de partage : une valeur
# fausse produit un site qui s'affiche bien mais se référence mal.
NEXT_PUBLIC_SITE_URL="https://azimut.page"

# Version affichée dans le pied de page.
NEXT_PUBLIC_APP_VERSION="0.1.0"

# Mesure d'audience Matomo. Laisser vide désactive complètement le script —
# c'est le comportement voulu en développement.
NEXT_PUBLIC_MATOMO_URL="https://matomo.leoderoin.fr"
NEXT_PUBLIC_MATOMO_SITE_ID=""

# Hébergeur du site, nommé dans les mentions légales — OBLIGATOIRE en France.
# Les valeurs par défaut sont déjà dans le code : ces variables ne servent qu'à
# les surcharger si l'hébergeur change.
NEXT_PUBLIC_HOST_NAME="LordHosting, SASU au capital de 1 000 €"
NEXT_PUBLIC_HOST_ADDRESS="5 square Frédéric Vallois, 75015 Paris, France"
NEXT_PUBLIC_HOST_PHONE="06 01 21 24 27"
NEXT_PUBLIC_HOST_SIREN="105 383 988 (RCS Paris)"

# Port publié sur l'hôte par la stack de production. À surcharger sur le
# serveur si un autre service occupe déjà la valeur par défaut.
AZIMUT_HOST_PORT=3007
