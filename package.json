{
    "name": "azimut",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev -p 3004",
        "prebuild": "tsx scripts/gen-nginx-redirects.mts",
        "build": "next build && tsx scripts/prune-export.mts",
        "lint": "eslint",
        "typecheck": "tsc --noEmit",
        "countries": "tsx scripts/build-countries.mts",
        "nginx": "tsx scripts/gen-nginx-redirects.mts",
        "check": "npm run typecheck && npm run lint && npm run build",
        "og": "tsx scripts/export-og.mts",
        "fonts": "cp node_modules/@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2 node_modules/@fontsource-variable/roboto-mono/files/roboto-mono-latin-wght-normal.woff2 src/fonts/"
    },
    "dependencies": {
        "lucide-react": "^1.33.0",
        "next": "16.3.1",
        "react": "19.2.8",
        "react-dom": "19.2.8"
    },
    "devDependencies": {
        "@fontsource-variable/archivo": "^5.2.5",
        "@fontsource-variable/roboto-mono": "^5.2.6",
        "@tailwindcss/postcss": "^4",
        "@types/node": "^26",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^9",
        "eslint-config-next": "16.3.1",
        "sharp": "^0.35.3",
        "tailwindcss": "^4",
        "tsx": "^4.20.3",
        "typescript": "^5"
    },
    "allowScripts": {
        "unrs-resolver@1.12.2": true,
        "esbuild@0.28.2": true,
        "sharp@0.35.3": true
    }
}
